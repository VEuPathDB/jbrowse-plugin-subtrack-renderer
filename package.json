{
  "version": "0.0.1",
  "name": "jbrowse-plugin-subtrack-renderer",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "renderer",
    "subtrack"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "config": {
    "port": 9002,
    "browse": {
      "port": 8999
    },
    "jbrowse": {
      "plugin": {
        "name": "SubtrackRenderer"
      }
    }
  },
  "scripts": {
    "setup": "npm-run-all setup:*",
    "setup:file": "ts-node scripts/setup.ts",
    "setup:jbrowse": "npm-run-all setup:jbrowse:*",
    "setup:jbrowse:clean": "rimraf .jbrowse",
    "setup:jbrowse:create": "jbrowse create .jbrowse",
    "clean": "rimraf dist",
    "start": "npm-run-all --sequential clean --parallel start:*",
    "start:watch": "cross-env JB_NPM=false NODE_ENV=development rollup --config --watch",
    "start:server": "serve --cors --listen $npm_package_config_port .",
    "prebuild": "npm-run-all clean",
    "build": "rollup --config",
    "browse": "npm-run-all jbrowse:*",
    "jbrowse:configure": "shx cp jbrowse_config.json .jbrowse/config.json",
    "jbrowse:serve": "cross-var serve --listen $npm_package_config_browse_port .jbrowse",
    "test": "jest",
    "test:e2e": "cross-var start-test \"npm-run-all --parallel start browse\" \"$npm_package_config_port|$npm_package_config_browse_port\" \"npm-run-all cypress:run\"",
    "cypress:run": "cross-var cypress run --headless --browser chrome --config baseUrl=http://localhost:$npm_package_config_browse_port",
    "cypress:open": "cross-var cypress open --config baseUrl=http://localhost:$npm_package_config_browse_port",
    "lint": "eslint --ext .js,.ts,.jsx,.tsx src/",
    "prepublishOnly": "npm-run-all test",
    "prepack": "npm-run-all build",
    "postversion": "git push --follow-tags"
  },
  "jbrowse-plugin": {
    "name": "SubtrackRenderer"
  },
  "peerDependencies": {
    "@jbrowse/core": "^4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "g2p_mapper": "^2.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.16.5",
    "@babel/preset-react": "^7.10.4",
    "@emotion/react": "^11.10.4",
    "@jbrowse/cli": "^4.3.0",
    "@jbrowse/core": "^4.3.0",
    "@jbrowse/development-tools": "^2.2.1",
    "@jbrowse/mobx-state-tree": "^5.10.2",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-data-grid": "^8.28.2",
    "@schemastore/package": "^0.0.10",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "canvas": "^3.2.3",
    "chalk": "^4.0.0",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0",
    "cypress": "^13.6.1",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react": "^7.20.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "flatbush": "^4.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.6.1",
    "jest-image-snapshot": "^6.5.2",
    "mobx": "^6.15.4",
    "mobx-react": "^9.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^5.0.1",
    "rollup": "^3.0.0",
    "rxjs": "^7.8.2",
    "serve": "^14.2.0",
    "shx": "^0.3.3",
    "start-server-and-test": "^2.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.3.0",
    "tslib": "^2.8.1",
    "tss-react": "^4.8.6",
    "typescript": "^5.9.3"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "cypress",
      "esbuild"
    ]
  }
}
